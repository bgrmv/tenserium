# Supabase — Supabase Dashboard → Settings → API → Publishable key
# Этот ключ публичный (как Stripe pk_*), безопасность через RLS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Netlify — только для CLI-деплоев (не нужно если деплой через Netlify UI)
NETLIFY_AUTH_TOKEN=your-netlify-token
NETLIFY_SITE_ID=your-site-id
